{
  "name": "headline-to-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn news headlines into settleable prediction-market drafts, or explain why they cannot be one. Nothing goes live without explicit editor approval.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/eval.ts"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
