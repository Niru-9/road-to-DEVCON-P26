# Headline to Market — example environment configuration.
# Copy to .env and fill in real values. NEVER put real credentials in tracked files.

# LLM provider: anthropic | openai | mock
# "mock" runs fully offline with deterministic heuristics (demo / eval smoke runs).
LLM_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI-compatible fallback (set LLM_PROVIDER=openai to use)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Model call behaviour (timeout in ms; retries is a finite cap)
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Server
PORT=8787
DB_PATH=data/app.db
